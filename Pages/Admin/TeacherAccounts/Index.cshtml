@page
@model SistemaAsistencia.Pages.Admin.TeacherAccounts.IndexModel
@{
    ViewData["Title"] = "Cuentas de profesores";
    var pendingCount = Model.Teachers.Count(teacher => !teacher.HasAccount);
}
<div class="admin-hero rounded-4 p-4 p-lg-5 mb-4"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><span class="hero-eyebrow"><i class="bi bi-person-workspace me-2"></i>CUENTAS VINCULADAS</span><h1 class="h2 fw-bold mt-2 mb-1">Accesos de profesores</h1><p class="mb-0">Crea credenciales ligadas al perfil; el correo y el nombre se toman del registro académico.</p></div><a asp-page="/Admin/Index" class="btn btn-light fw-semibold"><i class="bi bi-arrow-left me-2"></i>Panel de administración</a></div></div>
@if (TempData["TeacherAccountCreated"] is string created) { <div class="alert alert-success border-0 shadow-sm" role="status"><i class="bi bi-check-circle me-2"></i>@created</div> }
@if (TempData["TeacherAccountError"] is string error) { <div class="alert alert-danger border-0 shadow-sm" role="alert"><i class="bi bi-exclamation-circle me-2"></i>@error</div> }
<div class="row g-3 mb-4"><div class="col-6 col-md-4"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-blue"><i class="bi bi-people"></i></span><div class="small text-secondary mt-3">Profesores</div><div class="h3 fw-bold mb-0">@Model.Teachers.Count</div></div></div></div><div class="col-6 col-md-4"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-amber"><i class="bi bi-person-plus"></i></span><div class="small text-secondary mt-3">Sin cuenta</div><div class="h3 fw-bold mb-0">@pendingCount</div></div></div></div><div class="col-12 col-md-4"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-green"><i class="bi bi-person-check"></i></span><div class="small text-secondary mt-3">Con acceso</div><div class="h3 fw-bold mb-0">@(Model.Teachers.Count - pendingCount)</div></div></div></div></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Profesor</th><th>Correo para iniciar sesión</th><th>Estado de cuenta</th><th class="text-end pe-4">Acción</th></tr></thead><tbody>
@if (Model.Teachers.Count == 0) { <tr><td colspan="4" class="empty-state"><i class="bi bi-person-x"></i><span>Registra profesores antes de crear sus cuentas.</span></td></tr> }
@foreach (var teacher in Model.Teachers) { <tr><td class="ps-4 fw-semibold">@teacher.Name</td><td class="text-secondary">@teacher.Email</td><td><span class="badge rounded-pill @(teacher.HasAccount ? "status-approved" : "status-pending")">@(teacher.HasAccount ? "Cuenta activa" : "Sin cuenta")</span></td><td class="text-end pe-4">@if (teacher.HasAccount) { <form method="post" asp-page-handler="Revoke" asp-route-professorId="@teacher.ProfessorId" class="d-inline table-action-form"><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Revocar el acceso de este profesor?');"><i class="bi bi-person-x me-1"></i>Revocar acceso</button></form> } else if (string.IsNullOrWhiteSpace(teacher.Email)) { <span class="small text-danger">Falta correo en perfil</span> } else { <a asp-page="Create" asp-route-professorId="@teacher.ProfessorId" class="btn btn-sm btn-primary"><i class="bi bi-key me-1"></i>Crear acceso</a> }</td></tr> }
</tbody></table></div></div>
<div class="alert alert-info border-0 mt-4"><i class="bi bi-shield-lock me-2"></i>Las cuentas de profesor solo reciben el rol Profesor, con acceso a asistencia, justificaciones y su portal.</div>
