@page
@model SistemaAsistencia.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administración de cuentas";
}
<div class="admin-hero rounded-4 p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div><span class="hero-eyebrow"><i class="bi bi-shield-lock me-2"></i>ÁREA RESTRINGIDA</span><h1 class="h2 fw-bold mt-2 mb-1">Administración</h1><p class="mb-0">Controla el acceso al portal y administra las cuentas del personal.</p></div>
        <div class="d-flex flex-column flex-sm-row gap-2"><a asp-page="StudentAccounts/Index" class="btn btn-outline-light fw-semibold"><i class="bi bi-person-lock me-2"></i>Cuentas de estudiantes</a><a asp-page="TeacherAccounts/Index" class="btn btn-outline-light fw-semibold"><i class="bi bi-person-workspace me-2"></i>Cuentas de profesores</a><a asp-page="Create" class="btn btn-light fw-semibold"><i class="bi bi-person-plus me-2"></i>Crear administrador</a></div>
    </div>
</div>
@if (TempData["AccountCreated"] is string created) { <div class="alert alert-success border-0 shadow-sm" role="status"><i class="bi bi-check-circle me-2"></i>@created</div> }
<div class="d-flex justify-content-between align-items-end gap-3 mb-3"><div><span class="section-eyebrow">ACCESO AL SISTEMA</span><h2 class="h4 fw-bold mb-0">Cuentas de usuario</h2></div><span class="badge rounded-pill text-bg-light">@Model.Users.Count cuentas</span></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Nombre</th><th>Correo</th><th>Permisos</th><th>Estado</th></tr></thead><tbody>
@if (Model.Users.Count == 0) { <tr><td colspan="4" class="empty-state"><i class="bi bi-people"></i><span>No hay cuentas registradas.</span></td></tr> }
@foreach (var user in Model.Users) { <tr><td class="ps-4 fw-semibold">@user.Name</td><td>@user.Email</td><td>@if (user.Roles.Count == 0) { <span class="badge rounded-pill status-blue">Usuario</span> } else { @foreach (var role in user.Roles) { <span class="badge rounded-pill @(role == "Admin" ? "status-pending" : "status-blue") me-1">@(role == "Admin" ? "Administrador" : role)</span> } }</td><td><span class="badge rounded-pill @(user.IsLockedOut ? "status-rejected" : "status-approved")">@(user.IsLockedOut ? "Bloqueada" : "Activa")</span></td></tr> }
</tbody></table></div></div>
<div class="alert alert-info border-0 mt-4"><i class="bi bi-info-circle me-2"></i>Las cuentas no se pueden registrar desde la pantalla de acceso. Solo un administrador puede crearlas.</div>
