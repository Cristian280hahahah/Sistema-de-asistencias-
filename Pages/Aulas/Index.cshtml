@page
@model SistemaAsistencia.Pages.Aulas.IndexModel
@{ ViewData["Title"] = "Aulas"; }
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><span class="section-eyebrow">ORGANIZACIÓN ACADÉMICA</span><h1 class="h2 fw-bold mb-1">Aulas</h1><p class="text-secondary mb-0">Administra los espacios disponibles para las clases.</p></div><a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Nueva aula</a></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Aula</th><th>Ubicación</th><th>Secciones asignadas</th><th class="text-end pe-4">Acciones</th></tr></thead><tbody>
@if (Model.Aulas.Count == 0) { <tr><td colspan="4" class="empty-state"><i class="bi bi-door-closed"></i><span>No hay aulas registradas todavía.</span><a asp-page="Create" class="btn btn-sm btn-primary mt-2">Registrar la primera aula</a></td></tr> }
@foreach (var item in Model.Aulas) { <tr><td class="ps-4"><div class="d-flex align-items-center gap-2"><span class="module-icon table-module-icon"><i class="bi bi-door-open"></i></span><span class="fw-semibold">@item.Nombre</span></div></td><td>@(string.IsNullOrWhiteSpace(item.Ubicacion) ? "—" : item.Ubicacion)</td><td><span class="day-chip">@item.Secciones.Count @(item.Secciones.Count == 1 ? "sección" : "secciones")</span></td><td class="text-end pe-4 text-nowrap"><a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square"></i></a><a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Detalles" aria-label="Detalles"><i class="bi bi-eye"></i></a><a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button action-danger" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash"></i></a></td></tr> }
</tbody></table></div></div>
