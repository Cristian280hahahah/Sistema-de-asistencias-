@page
@model SistemaAsistencia.Pages.Aulas.DetailsModel
@{ ViewData["Title"] = "Detalle de aula"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">ORGANIZACIÓN ACADÉMICA</span><h1 class="h2 fw-bold mb-1">Detalle del aula</h1><p class="text-secondary mb-0">Información y secciones que utilizan este espacio.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4 detail-card"><div class="card-body p-4 p-md-5"><div class="d-flex align-items-center gap-3 mb-4"><span class="form-heading-icon"><i class="bi bi-door-open"></i></span><div><div class="small text-secondary">AULA</div><h2 class="h4 fw-bold mb-0">@Model.Aula.Nombre</h2></div></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Ubicación</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Aula.Ubicacion) ? "—" : Model.Aula.Ubicacion)</dd><dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Aula.Descripcion) ? "—" : Model.Aula.Descripcion)</dd><dt class="col-sm-4">Secciones asignadas</dt><dd class="col-sm-8">@(Model.Aula.Secciones.Count == 0 ? "Ninguna" : string.Join(", ", Model.Aula.Secciones.Select(section => section.Materia?.Nombre ?? "Clase")))</dd></dl><div class="form-actions"><a asp-page="./Edit" asp-route-id="@Model.Aula.Id" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Editar aula</a><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></div></div></div></div>
