@page
@model SistemaAsistencia.Pages.Aulas.CreateModel
@{ ViewData["Title"] = "Crear aula"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">ORGANIZACIÓN ACADÉMICA</span><h1 class="h2 fw-bold mb-1">Nueva aula</h1><p class="text-secondary mb-0">Registra un espacio para asignarlo a las secciones.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9 col-xl-8"><div class="card form-card form-section border-0 shadow-sm rounded-4"><div class="form-card-heading"><span class="form-heading-icon"><i class="bi bi-door-open"></i></span><div><h2 class="h5 fw-bold mb-1">Información del aula</h2><p class="small text-secondary mb-0">El nombre debe ser único; la ubicación y descripción son opcionales.</p></div></div><div class="card-body p-4 p-md-5 pt-3"><form method="post" class="entity-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><div class="row g-3"><div class="col-12"><label asp-for="Aula.Nombre" class="form-label">Nombre del aula</label><div class="input-group"><span class="input-group-text"><i class="bi bi-door-closed"></i></span><input asp-for="Aula.Nombre" class="form-control" placeholder="Ej.: Aula 12 o Centro de Cómputo" /></div><span asp-validation-for="Aula.Nombre" class="text-danger small"></span></div><div class="col-12"><label asp-for="Aula.Ubicacion" class="form-label">Ubicación <span class="text-secondary fw-normal">(opcional)</span></label><div class="input-group"><span class="input-group-text"><i class="bi bi-geo-alt"></i></span><input asp-for="Aula.Ubicacion" class="form-control" placeholder="Ej.: Edificio A, segundo piso" /></div><span asp-validation-for="Aula.Ubicacion" class="text-danger small"></span></div><div class="col-12"><label asp-for="Aula.Descripcion" class="form-label">Descripción <span class="text-secondary fw-normal">(opcional)</span></label><textarea asp-for="Aula.Descripcion" class="form-control" rows="3" placeholder="Capacidad, equipo u otra información útil"></textarea><span asp-validation-for="Aula.Descripcion" class="text-danger small"></span></div></div><div class="form-actions mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Guardar aula</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
