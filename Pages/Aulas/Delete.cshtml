@page
@model SistemaAsistencia.Pages.Aulas.DeleteModel
@{ ViewData["Title"] = "Eliminar aula"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">ORGANIZACIÓN ACADÉMICA</span><h1 class="h2 fw-bold mb-1">Eliminar aula</h1><p class="text-secondary mb-0">Verifica las asignaciones antes de eliminar este espacio.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5"><div class="alert @(Model.SeccionesAsignadas > 0 ? "alert-warning" : "alert-danger") border-0" role="alert"><div class="d-flex gap-3"><i class="bi @(Model.SeccionesAsignadas > 0 ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill") fs-4"></i><div><h2 class="h5 fw-bold">@(Model.SeccionesAsignadas > 0 ? "Esta aula todavía está en uso" : "¿Eliminar esta aula?")</h2><p class="mb-0">@(Model.SeccionesAsignadas > 0 ? $"Tiene {Model.SeccionesAsignadas} sección(es) asignada(s). No se puede eliminar hasta quitar esas asignaciones." : "Esta acción no se puede deshacer.")</p></div></div></div><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Aula</dt><dd class="col-sm-8">@Model.Aula.Nombre</dd><dt class="col-sm-4">Ubicación</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Aula.Ubicacion) ? "—" : Model.Aula.Ubicacion)</dd></dl><form method="post" class="form-actions"><input type="hidden" asp-for="Aula.Id" />@if (Model.SeccionesAsignadas == 0) { <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Eliminar aula</button> }<a asp-page="./Index" class="btn btn-light"><i class="bi bi-x-lg me-2"></i>Cancelar</a></form></div></div></div></div>
