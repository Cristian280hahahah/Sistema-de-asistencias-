@page
@model IndexModel
@{
    ViewData["Title"] = "Panel de control";
}

<section class="dashboard-hero rounded-4 p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="hero-eyebrow"><i class="bi bi-stars me-2"></i>PORTAL DE GESTIÓN ACADÉMICA</span>
            <h1 class="display-6 fw-bold mt-3 mb-2">Todo tu centro educativo,<br class="d-none d-md-block"> en un solo lugar.</h1>
            <p class="mb-4">Administra estudiantes, docentes, aulas, materias y cuentas desde un panel claro y organizado.</p>
        </div>
        <div class="col-lg-4 d-none d-lg-flex justify-content-end"><div class="hero-art"><i class="bi bi-mortarboard-fill"></i></div></div>
    </div>
</section>

<div class="d-flex align-items-center justify-content-between mb-3"><div><span class="section-eyebrow">RESUMEN GENERAL</span><h2 class="h4 fw-bold mb-0">Indicadores del sistema</h2></div></div>
<div class="row g-3 mb-5">
    <div class="col-6 col-xl-3"><a asp-page="/Estudiantes/Index" class="text-decoration-none"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-blue"><i class="bi bi-person-badge"></i></span><div class="small text-secondary mt-3">Estudiantes</div><div class="h2 fw-bold mb-0 text-dark">@Model.Estudiantes</div></div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-page="/Profesores/Index" class="text-decoration-none"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-green"><i class="bi bi-person-workspace"></i></span><div class="small text-secondary mt-3">Profesores</div><div class="h2 fw-bold mb-0 text-dark">@Model.Profesores</div></div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-page="/Materias/Index" class="text-decoration-none"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-amber"><i class="bi bi-journals"></i></span><div class="small text-secondary mt-3">Materias</div><div class="h2 fw-bold mb-0 text-dark">@Model.Materias</div></div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-page="/Secciones/Index" class="text-decoration-none"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-red"><i class="bi bi-collection"></i></span><div class="small text-secondary mt-3">Clases programadas</div><div class="h2 fw-bold mb-0 text-dark">@Model.Secciones</div></div></div></a></div>
</div>

<div class="d-flex align-items-center justify-content-between mb-3"><div><span class="section-eyebrow">ACCESOS RÁPIDOS</span><h2 class="h4 fw-bold mb-0">Módulos académicos</h2></div></div>
<div class="row g-3">
    <div class="col-12 col-md-6 col-xl-4"><a asp-page="/Estudiantes/Index" class="module-link"><span class="module-icon"><i class="bi bi-people"></i></span><span><strong>Estudiantes</strong><small>Expedientes y matrícula</small></span><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-12 col-md-6 col-xl-4"><a asp-page="/Profesores/Index" class="module-link"><span class="module-icon"><i class="bi bi-person-workspace"></i></span><span><strong>Profesores</strong><small>Equipo docente</small></span><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-12 col-md-6 col-xl-4"><a asp-page="/Materias/Index" class="module-link"><span class="module-icon"><i class="bi bi-journals"></i></span><span><strong>Materias</strong><small>Catálogo académico</small></span><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-12 col-md-6 col-xl-4"><a asp-page="/Secciones/Index" class="module-link"><span class="module-icon"><i class="bi bi-collection"></i></span><span><strong>Secciones</strong><small>Grupos y horarios</small></span><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    <div class="col-12 col-md-6 col-xl-4"><a asp-page="/Aulas/Index" class="module-link"><span class="module-icon"><i class="bi bi-door-open"></i></span><span><strong>Aulas</strong><small>Espacios para las clases</small></span><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col-12 col-md-6 col-xl-4"><a asp-page="/Admin/TeacherAccounts/Index" class="module-link"><span class="module-icon"><i class="bi bi-person-lock"></i></span><span><strong>Cuentas de profesores</strong><small>Accesos y permisos docentes</small></span><i class="bi bi-arrow-up-right ms-auto"></i></a></div>
    }
</div>
@if (User.IsInRole("Admin"))
{
    <section class="admin-dashboard-link mt-4"><div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3"><div class="d-flex align-items-center gap-3"><span class="admin-dashboard-icon"><i class="bi bi-shield-lock"></i></span><div><span class="section-eyebrow mb-1">SOLO ADMINISTRADORES</span><h2 class="h5 fw-bold mb-1">Panel de administración</h2><p class="text-secondary small mb-0">Gestiona cuentas y permisos de acceso al portal.</p></div></div><a asp-page="/Admin/Index" class="btn btn-primary"><i class="bi bi-arrow-up-right-square me-2"></i>Abrir panel</a></div></section>
}
