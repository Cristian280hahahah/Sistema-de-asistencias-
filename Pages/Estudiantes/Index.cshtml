@page
@model SistemaAsistencia.Pages.Estudiantes.IndexModel
@{ ViewData["Title"] = "Estudiantes"; }
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><span class="section-eyebrow">COMUNIDAD EDUCATIVA</span><h1 class="h2 fw-bold mb-1">Estudiantes</h1><p class="text-secondary mb-0">Consulta y administra los expedientes estudiantiles.</p></div><a asp-page="Create" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Registrar estudiante</a></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Código</th><th>Nombre completo</th><th>Correo electrónico</th><th class="text-end pe-4">Acciones</th></tr></thead><tbody>
@if (Model.Estudiantes.Count == 0) { <tr><td colspan="4" class="empty-state"><i class="bi bi-person-x"></i><span>No hay estudiantes registrados todavía.</span></td></tr> }
@foreach (var item in Model.Estudiantes)
{
    var codigoValido = System.Text.RegularExpressions.Regex.IsMatch(item.Codigo, "^[0-9]{8}$");
    <tr>
        <td class="ps-4">
            @if (codigoValido)
            {
                <span class="code-chip">@item.Codigo</span>
            }
            else
            {
                <span class="badge rounded-pill status-rejected" title="Código antiguo no válido">@item.Codigo</span>
                <small class="text-danger d-block mt-1">Corrige el código a 8 números</small>
            }
        </td>
        <td><div class="d-flex align-items-center gap-2"><span class="avatar-circle">@item.Nombre[..1].ToUpper()</span><span class="fw-semibold">@item.Nombre</span></div></td>
        <td class="text-secondary">@item.Email</td>
        <td class="text-end pe-4 text-nowrap"><a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square"></i></a><a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Detalles" aria-label="Detalles"><i class="bi bi-eye"></i></a><a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button action-danger" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash"></i></a></td>
    </tr>
}
</tbody></table></div></div>
