@page
@model SistemaAsistencia.Pages.Estudiantes.DetailsModel
@{ ViewData["Title"] = "Expediente de estudiante"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">COMUNIDAD EDUCATIVA</span><h1 class="h2 fw-bold mb-1">Expediente de estudiante</h1><p class="text-secondary mb-0">Información académica y de contacto.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4 detail-card"><div class="card-body p-4 p-md-5"><div class="d-flex align-items-center gap-3 mb-4"><span class="avatar-circle avatar-large">@Model.Estudiante.Nombre[..1].ToUpper()</span><div><div class="small text-secondary">ESTUDIANTE</div><h2 class="h4 fw-bold mb-0">@Model.Estudiante.Nombre</h2></div></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Código / carnet</dt><dd class="col-sm-8">@Model.Estudiante.Codigo</dd><dt class="col-sm-4">Correo electrónico</dt><dd class="col-sm-8">@Model.Estudiante.Email</dd></dl><div class="form-actions"><a asp-page="./Edit" asp-route-id="@Model.Estudiante.Id" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Editar estudiante</a><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></div></div></div></div>
