@page
@model SistemaAsistencia.Pages.Estudiantes.EditModel
@{ ViewData["Title"] = "Editar estudiante"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">COMUNIDAD EDUCATIVA</span><h1 class="h2 fw-bold mb-1">Editar estudiante</h1><p class="text-secondary mb-0">Actualiza la información del expediente académico.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9 col-xl-8"><div class="card form-card form-student border-0 shadow-sm rounded-4"><div class="form-card-heading"><span class="form-heading-icon"><i class="bi bi-person-gear"></i></span><div><h2 class="h5 fw-bold mb-1">Información personal</h2><p class="small text-secondary mb-0">Revisa los datos antes de guardar.</p></div></div><div class="card-body p-4 p-md-5 pt-3">
<form method="post" class="entity-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><input type="hidden" asp-for="Estudiante.Id" />
<div class="row g-3"><div class="col-12 col-md-6"><label asp-for="Estudiante.Codigo" class="form-label">Código / carnet</label><div class="input-group"><span class="input-group-text"><i class="bi bi-upc-scan"></i></span><input asp-for="Estudiante.Codigo" class="form-control" inputmode="numeric" maxlength="8" pattern="[0-9]{8}" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8)" /></div><span asp-validation-for="Estudiante.Codigo" class="text-danger small"></span></div><div class="col-12 col-md-6"><label asp-for="Estudiante.Nombre" class="form-label">Nombre completo</label><div class="input-group"><span class="input-group-text"><i class="bi bi-person"></i></span><input asp-for="Estudiante.Nombre" class="form-control" /></div><span asp-validation-for="Estudiante.Nombre" class="text-danger small"></span></div><div class="col-12"><label asp-for="Estudiante.Email" class="form-label">Correo electrónico</label><div class="input-group"><span class="input-group-text"><i class="bi bi-envelope"></i></span><input asp-for="Estudiante.Email" type="email" class="form-control" autocapitalize="none" spellcheck="false" /></div><span asp-validation-for="Estudiante.Email" class="text-danger small"></span></div></div>
<div class="form-actions mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Guardar cambios</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
