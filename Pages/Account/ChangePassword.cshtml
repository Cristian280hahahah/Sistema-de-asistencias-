@page
@model SistemaAsistencia.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}
<div class="form-page-header mb-4"><span class="section-eyebrow">SEGURIDAD DE LA CUENTA</span><h1 class="h2 fw-bold mb-1">Cambiar contraseña</h1><p class="text-secondary mb-0">Usa una contraseña única de al menos 8 caracteres.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-7"><div class="card form-card form-admin border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5">
@if (TempData["PasswordChanged"] is string success) { <div class="alert alert-success border-0" role="status"><i class="bi bi-check-circle me-2"></i>@success</div> }
<form method="post" class="account-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div>
    <div class="mb-3"><label asp-for="Input.CurrentPassword" class="form-label fw-semibold">Contraseña actual</label><input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span></div>
    <div class="mb-3"><label asp-for="Input.NewPassword" class="form-label fw-semibold">Nueva contraseña</label><input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" /><div class="form-text">Debe incluir mayúscula, minúscula, número y símbolo.</div><span asp-validation-for="Input.NewPassword" class="text-danger small"></span></div>
    <div class="mb-4"><label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirmar nueva contraseña</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span></div>
    <div class="form-actions"><button type="submit" class="btn btn-primary"><i class="bi bi-shield-check me-2"></i>Actualizar contraseña</button></div>
</form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
