@page "/Justificaciones"
@model SistemaAsistencia.Pages.Justificaciones.IndexModel

@{
    ViewData["Title"] = "Justificaciones";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <span class="section-eyebrow">GESTIÓN ACADÉMICA</span>
        <h1 class="h2 fw-bold mb-1">Justificaciones</h1>
        <p class="text-secondary mb-0">Administra y da seguimiento a las solicitudes de asistencia.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Nueva solicitud</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icon kpi-total"><i class="bi bi-files"></i></span><div><div class="small text-secondary">Total de solicitudes</div><div class="h3 fw-bold mb-0">@Model.Total</div></div>
        </div></div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icon kpi-pending"><i class="bi bi-hourglass-split"></i></span><div><div class="small text-secondary">Pendientes</div><div class="h3 fw-bold mb-0">@Model.Pendientes</div></div>
        </div></div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body d-flex align-items-center gap-3">
            <span class="kpi-icon kpi-approved"><i class="bi bi-check2-circle"></i></span><div><div class="small text-secondary">Aprobadas</div><div class="h3 fw-bold mb-0">@Model.Aprobadas</div></div>
        </div></div>
    </div>
</div>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
    <h2 class="h5 fw-semibold mb-0">Solicitudes registradas</h2>
    <form method="get" class="d-flex align-items-center gap-2">
        <label for="estado" class="small fw-semibold text-secondary text-nowrap">Filtrar estado</label>
        <select id="estado" name="estado" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Filtrar por estado">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Estado))">Todas</option>
            <option value="Pendiente" selected="@(Model.Estado == "Pendiente")">Pendientes</option>
            <option value="Aprobado" selected="@(Model.Estado == "Aprobado")">Aprobadas</option>
            <option value="Rechazado" selected="@(Model.Estado == "Rechazado")">Rechazadas</option>
        </select>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle border-0 mb-0">
            <thead class="table-light"><tr>
                <th class="ps-4">Estudiante</th><th>Aula</th><th>Fecha de asistencia</th><th>Motivo</th><th>Estado</th><th class="text-end pe-4">Acciones</th>
            </tr></thead>
            <tbody>
            @if (Model.Justificaciones.Count == 0)
            {
                <tr><td colspan="6" class="text-center py-5 text-secondary"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No hay solicitudes para mostrar.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Justificaciones)
                {
                    var estado = item.Estado.ToString();
                    var badgeClass = estado == "Aprobado" ? "status-approved" : estado == "Rechazado" ? "status-rejected" : "status-pending";
                    <tr>
                        <td class="ps-4 fw-semibold">@(item.Asistencia?.Estudiante?.Nombre ?? "—")</td>
                        <td>@(item.Asistencia?.Seccion?.Aula?.Nombre ?? "—")</td>
                        <td>@item.Asistencia?.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="reason-cell">@item.Motivo</td>
                        <td><span class="badge rounded-pill @badgeClass">@estado</span></td>
                        <td class="text-end pe-4 text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" aria-label="Editar" title="Editar"><i class="bi bi-pencil-square"></i></a>
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" aria-label="Ver detalles" title="Detalles"><i class="bi bi-eye"></i></a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button action-danger" aria-label="Eliminar" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
