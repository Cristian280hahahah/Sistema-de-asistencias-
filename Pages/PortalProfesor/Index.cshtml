@page
@model SistemaAsistencia.Pages.PortalProfesor.IndexModel
@{
    ViewData["Title"] = "Portal del profesor";
}
<section class="student-hero rounded-4 p-4 p-lg-5 mb-4"><div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><span class="hero-eyebrow"><i class="bi bi-person-workspace me-2"></i>PORTAL DEL PROFESOR</span><h1 class="h2 fw-bold mt-2 mb-1">¡Hola, @Model.ProfesorNombre!</h1><p class="mb-0">Consulta tus clases, registra asistencias y revisa justificaciones.</p></div><div class="d-flex flex-column flex-sm-row gap-2"><a asp-page="/Asistencias/Create" class="btn btn-light fw-semibold"><i class="bi bi-plus-circle me-2"></i>Registrar asistencia</a><a asp-page="/Justificaciones/Index" class="btn btn-outline-light fw-semibold"><i class="bi bi-file-earmark-check me-2"></i>Justificaciones</a></div></div></section>
<div class="row g-3 mb-4"><div class="col-6 col-md-6"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-blue"><i class="bi bi-calendar2-check"></i></span><div class="small text-secondary mt-3">Asistencias registradas hoy</div><div class="h3 fw-bold mb-0">@Model.AsistenciasHoy</div></div></div></div><div class="col-6 col-md-6"><div class="card dashboard-stat h-100"><div class="card-body"><span class="stat-icon stat-amber"><i class="bi bi-hourglass-split"></i></span><div class="small text-secondary mt-3">Justificaciones pendientes</div><div class="h3 fw-bold mb-0">@Model.JustificacionesPendientes</div></div></div></div></div>
<div class="d-flex align-items-center justify-content-between mb-3"><div><span class="section-eyebrow">HORARIO ASIGNADO</span><h2 class="h5 fw-bold mb-0">Mis clases</h2></div></div>
@if (Model.Clases.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4"><div class="card-body text-center text-secondary py-5"><i class="bi bi-calendar-x fs-3 d-block mb-2"></i>No tienes clases asignadas. Contacta al administrador.</div></div>
}
else
{
    <div class="row g-3">
    @foreach (var clase in Model.Clases)
    {
        <div class="col-12 col-md-6 col-xl-4"><article class="student-section-card h-100"><div class="d-flex justify-content-between gap-3"><div><span class="section-eyebrow">@clase.Dia.NombreEnEspanol()</span><h3 class="h6 fw-bold mb-1">@clase.Materia</h3><div class="small text-secondary"><i class="bi bi-geo-alt me-1"></i>@clase.Aula</div></div><span class="schedule-time"><i class="bi bi-clock me-1"></i>@clase.HoraInicio.ToString(@"hh\:mm")–@clase.HoraFin.ToString(@"hh\:mm")</span></div></article></div>
    }
    </div>
}
