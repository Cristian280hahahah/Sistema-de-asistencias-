@page
@model SistemaAsistencia.Pages.Secciones.DetailsModel
@{ ViewData["Title"] = "Detalle de sección"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">ORGANIZACIÓN ACADÉMICA</span><h1 class="h2 fw-bold mb-1">Detalle de sección</h1><p class="text-secondary mb-0">Información académica y horario de la clase.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4 detail-card"><div class="card-body p-4 p-md-5"><div class="d-flex align-items-center gap-3 mb-4"><span class="form-heading-icon"><i class="bi bi-door-open"></i></span><div><div class="small text-secondary">AULA</div><h2 class="h4 fw-bold mb-0">@Model.Seccion.Aula!.Nombre</h2></div></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Materia</dt><dd class="col-sm-8">@(Model.Seccion.Materia?.Nombre ?? "—")</dd><dt class="col-sm-4">Profesor responsable</dt><dd class="col-sm-8">@(Model.Seccion.Profesor?.Nombre ?? "—")</dd><dt class="col-sm-4">Día</dt><dd class="col-sm-8">@Model.Seccion.Dia.NombreEnEspanol()</dd><dt class="col-sm-4">Horario</dt><dd class="col-sm-8">@Model.Seccion.HoraInicio.ToString(@"hh\:mm") – @Model.Seccion.HoraFin.ToString(@"hh\:mm")</dd></dl><div class="form-actions"><a asp-page="./Edit" asp-route-id="@Model.Seccion.Id" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Editar sección</a><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></div></div></div></div>
