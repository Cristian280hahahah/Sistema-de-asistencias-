@page
@model SistemaAsistencia.Pages.Secciones.IndexModel
@{ ViewData["Title"] = "Secciones"; }
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><span class="section-eyebrow">ORGANIZACIÓN ACADÉMICA</span><h1 class="h2 fw-bold mb-1">Secciones y horarios</h1><p class="text-secondary mb-0">Gestiona aulas, docentes responsables y horarios de clase.</p></div><a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Nueva sección</a></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Aula</th><th>Materia</th><th>Profesor</th><th>Día</th><th>Horario</th><th class="text-end pe-4">Acciones</th></tr></thead><tbody>
@if (Model.Secciones.Count == 0) { <tr><td colspan="6" class="empty-state"><i class="bi bi-collection"></i><span>No hay secciones registradas todavía.</span></td></tr> }
@foreach (var item in Model.Secciones) { <tr><td class="ps-4 fw-semibold">@item.Aula!.Nombre</td><td>@(item.Materia?.Nombre ?? "—")</td><td>@(item.Profesor?.Nombre ?? "—")</td><td><span class="day-chip">@item.Dia.NombreEnEspanol()</span></td><td class="text-nowrap"><i class="bi bi-clock me-1 text-secondary"></i>@item.HoraInicio.ToString(@"hh\:mm") – @item.HoraFin.ToString(@"hh\:mm")</td><td class="text-end pe-4 text-nowrap"><a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square"></i></a><a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Detalles" aria-label="Detalles"><i class="bi bi-eye"></i></a><a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button action-danger" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash"></i></a></td></tr> }
</tbody></table></div></div>
