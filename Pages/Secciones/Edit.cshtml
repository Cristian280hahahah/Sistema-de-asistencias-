@page
@model SistemaAsistencia.Pages.Secciones.EditModel
@{ ViewData["Title"] = "Editar sección"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">ORGANIZACIÓN ACADÉMICA</span><h1 class="h2 fw-bold mb-1">Editar sección</h1><p class="text-secondary mb-0">Actualiza el aula, la asignación académica y el horario.</p></div>
<div class="row justify-content-center"><div class="col-12 col-xl-10"><div class="card form-card form-section border-0 shadow-sm rounded-4"><div class="form-card-heading"><span class="form-heading-icon"><i class="bi bi-door-open"></i></span><div><h2 class="h5 fw-bold mb-1">Datos de la clase y horario</h2><p class="small text-secondary mb-0">Comprueba que el profesor no tenga otra clase en el mismo horario.</p></div></div><div class="card-body p-4 p-md-5 pt-3"><form method="post" class="entity-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><input type="hidden" asp-for="Seccion.Id" />
@if (Model.AulasDisponibles == 0) { <div class="alert alert-info border-0" role="status">No hay aulas disponibles. <a asp-page="/Aulas/Create" class="alert-link">Registra un aula</a> para asignarla.</div> }
<div class="row g-3">
<div class="col-12 col-md-6"><label asp-for="AulaId" class="form-label">Aula</label><select asp-for="AulaId" class="form-select" asp-items="Model.AulasList"><option value="">Selecciona un aula</option></select><span asp-validation-for="AulaId" class="text-danger small"></span></div>
<div class="col-12 col-md-6"><label asp-for="MateriaId" class="form-label">Materia</label><select asp-for="MateriaId" class="form-select" asp-items="Model.MateriasList"><option value="">Selecciona una materia</option></select><span asp-validation-for="MateriaId" class="text-danger small"></span></div>
<div class="col-12 col-md-6"><label asp-for="ProfesorId" class="form-label">Profesor responsable</label><select asp-for="ProfesorId" class="form-select" asp-items="Model.ProfesoresList"><option value="">Selecciona un profesor</option></select><span asp-validation-for="ProfesorId" class="text-danger small"></span></div>
<div class="col-12 col-md-6"><label asp-for="Dia" class="form-label">Día de la semana</label><select asp-for="Dia" class="form-select"><option value="">Selecciona un día</option><option value="0">Domingo</option><option value="1">Lunes</option><option value="2">Martes</option><option value="3">Miércoles</option><option value="4">Jueves</option><option value="5">Viernes</option><option value="6">Sábado</option></select><span asp-validation-for="Dia" class="text-danger small"></span></div>
<div class="col-12"><div class="schedule-panel"><div class="small fw-semibold text-secondary mb-3"><i class="bi bi-clock me-2"></i>Horario de clase</div><div class="row g-3"><div class="col-12 col-sm-6"><label asp-for="HoraInicio" class="form-label">Hora de inicio</label><input asp-for="HoraInicio" type="time" class="form-control" /><span asp-validation-for="HoraInicio" class="text-danger small"></span></div><div class="col-12 col-sm-6"><label asp-for="HoraFin" class="form-label">Hora de fin</label><input asp-for="HoraFin" type="time" class="form-control" /><span asp-validation-for="HoraFin" class="text-danger small"></span></div></div></div></div>
</div><div class="form-actions mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Guardar cambios</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
