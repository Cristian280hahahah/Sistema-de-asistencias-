@page
@model SistemaAsistencia.Pages.Asistencias.DetailsModel
@{ ViewData["Title"] = "Detalle de asistencia"; var state = Model.Asistencia.Estado.ToString(); var stateClass = state == "Presente" ? "status-approved" : state == "Ausente" ? "status-rejected" : state == "Justificado" ? "status-blue" : "status-pending"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">SEGUIMIENTO DIARIO</span><h1 class="h2 fw-bold mb-1">Detalle de asistencia</h1><p class="text-secondary mb-0">Resumen del registro seleccionado.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4 detail-card"><div class="card-body p-4 p-md-5"><div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><div class="small text-secondary">ESTUDIANTE</div><h2 class="h4 fw-bold mb-0">@(Model.Asistencia.Estudiante?.Nombre ?? "Sin estudiante")</h2></div><span class="badge rounded-pill @stateClass">@state</span></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Fecha</dt><dd class="col-sm-8">@Model.Asistencia.Fecha.ToString("dd/MM/yyyy")</dd><dt class="col-sm-4">Hora de llegada</dt><dd class="col-sm-8">@Model.Asistencia.HoraLlegada.ToString(@"hh\:mm")</dd><dt class="col-sm-4">Aula</dt><dd class="col-sm-8">@(Model.Asistencia.Seccion?.Aula?.Nombre ?? "—")</dd></dl><div class="form-actions"><a asp-page="./Edit" asp-route-id="@Model.Asistencia.Id" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Editar asistencia</a><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></div></div></div></div>
