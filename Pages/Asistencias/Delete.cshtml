@page
@model SistemaAsistencia.Pages.Asistencias.DeleteModel
@{ ViewData["Title"] = "Eliminar asistencia"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">SEGUIMIENTO DIARIO</span><h1 class="h2 fw-bold mb-1">Eliminar asistencia</h1><p class="text-secondary mb-0">Revisa el registro antes de confirmar la eliminación.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5"><div class="alert alert-danger border-0" role="alert"><div class="d-flex gap-3"><i class="bi bi-exclamation-triangle-fill fs-4"></i><div><h2 class="h5 fw-bold">¿Eliminar este registro?</h2><p class="mb-0">Esta acción no se puede deshacer.</p></div></div></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Estudiante</dt><dd class="col-sm-8">@(Model.Asistencia.Estudiante?.Nombre ?? "—")</dd><dt class="col-sm-4">Aula</dt><dd class="col-sm-8">@(Model.Asistencia.Seccion?.Aula?.Nombre ?? "—")</dd><dt class="col-sm-4">Fecha</dt><dd class="col-sm-8">@Model.Asistencia.Fecha.ToString("dd/MM/yyyy")</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@Model.Asistencia.Estado</dd></dl><form method="post" class="form-actions"><input type="hidden" asp-for="Asistencia.Id" /><button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Eliminar asistencia</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-x-lg me-2"></i>Cancelar</a></form></div></div></div></div>
