@page
@model SistemaAsistencia.Pages.Asistencias.CreateModel
@{ ViewData["Title"] = "Registrar asistencia"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">SEGUIMIENTO DIARIO</span><h1 class="h2 fw-bold mb-1">Registrar asistencia</h1><p class="text-secondary mb-0">Selecciona el estudiante y la sección para registrar su llegada.</p></div>
<div class="row justify-content-center"><div class="col-12 col-xl-10"><div class="card form-card form-attendance border-0 shadow-sm rounded-4"><div class="form-card-heading"><span class="form-heading-icon"><i class="bi bi-calendar2-plus"></i></span><div><h2 class="h5 fw-bold mb-1">Datos de asistencia</h2><p class="small text-secondary mb-0">La puntualidad se determina automáticamente según el horario.</p></div></div><div class="card-body p-4 p-md-5 pt-3"><form method="post" class="entity-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><div class="row g-3">
<div class="col-12 col-md-6"><label asp-for="Asistencia.Fecha" class="form-label">Fecha</label><div class="input-group"><span class="input-group-text"><i class="bi bi-calendar3"></i></span><input asp-for="Asistencia.Fecha" type="date" class="form-control" min="@Model.MinimumDate" max="@Model.MaximumDate" /></div><div class="form-text">Solo se permiten fechas del mes actual hasta hoy.</div><span asp-validation-for="Asistencia.Fecha" class="text-danger small"></span></div>
<div class="col-12 col-md-6"><label asp-for="Asistencia.HoraLlegada" class="form-label">Hora de llegada</label><div class="input-group"><span class="input-group-text"><i class="bi bi-clock"></i></span><input asp-for="Asistencia.HoraLlegada" type="time" class="form-control" /></div><span asp-validation-for="Asistencia.HoraLlegada" class="text-danger small"></span></div>
<div class="col-12 col-md-6"><label asp-for="Asistencia.EstudianteId" class="form-label">Estudiante</label><select asp-for="Asistencia.EstudianteId" class="form-select" asp-items="ViewBag.EstudianteId"><option value="">Selecciona un estudiante</option></select><span asp-validation-for="Asistencia.EstudianteId" class="text-danger small"></span></div>
<div class="col-12 col-md-6"><label asp-for="Asistencia.SeccionId" class="form-label">Sección / clase</label><select asp-for="Asistencia.SeccionId" class="form-select" asp-items="ViewBag.SeccionId"><option value="">Selecciona una sección</option></select><span asp-validation-for="Asistencia.SeccionId" class="text-danger small"></span></div>
<div class="col-12"><div class="status-info"><i class="bi bi-info-circle-fill"></i><span><strong>Estado automático.</strong> El sistema calcula presente, tardanza o ausencia en función de la hora de llegada y el horario de la sección.</span></div></div>
</div><div class="form-actions mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-2"></i>Guardar asistencia</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
