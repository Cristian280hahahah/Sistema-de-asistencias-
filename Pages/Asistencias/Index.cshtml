@page
@model SistemaAsistencia.Pages.Asistencias.IndexModel
@{ ViewData["Title"] = "Asistencias"; }
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><span class="section-eyebrow">SEGUIMIENTO DIARIO</span><h1 class="h2 fw-bold mb-1">Registro de asistencias</h1><p class="text-secondary mb-0">Consulta y registra la asistencia de cada estudiante.</p></div><a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Registrar asistencia</a></div>
<div class="card border-0 shadow-sm rounded-4 overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Fecha</th><th>Hora</th><th>Estudiante</th><th>Aula</th><th>Estado</th><th class="text-end pe-4">Acciones</th></tr></thead><tbody>
@if (Model.Asistencia.Count == 0) { <tr><td colspan="6" class="empty-state"><i class="bi bi-calendar2-x"></i><span>No hay registros de asistencia todavía.</span></td></tr> }
@foreach (var item in Model.Asistencia) { var state = item.Estado.ToString(); var stateClass = state == "Presente" ? "status-approved" : state == "Ausente" ? "status-rejected" : state == "Justificado" ? "status-blue" : "status-pending"; <tr><td class="ps-4">@item.Fecha.ToString("dd/MM/yyyy")</td><td>@item.HoraLlegada.ToString(@"hh\:mm")</td><td class="fw-semibold">@(item.Estudiante?.Nombre ?? "—")</td><td>@(item.Seccion?.Aula?.Nombre ?? "—")</td><td><span class="badge rounded-pill @stateClass">@state</span></td><td class="text-end pe-4 text-nowrap"><a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Editar" aria-label="Editar"><i class="bi bi-pencil-square"></i></a><a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button" title="Detalles" aria-label="Detalles"><i class="bi bi-eye"></i></a><a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light action-button action-danger" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash"></i></a></td></tr> }
</tbody></table></div></div>
