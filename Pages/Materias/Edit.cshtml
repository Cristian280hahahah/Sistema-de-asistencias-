@page
@model SistemaAsistencia.Pages.Materias.EditModel
@{ ViewData["Title"] = "Editar materia"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">PLAN DE ESTUDIOS</span><h1 class="h2 fw-bold mb-1">Editar materia</h1><p class="text-secondary mb-0">Modifica el código o nombre de la asignatura.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9 col-xl-8"><div class="card form-card form-subject border-0 shadow-sm rounded-4"><div class="form-card-heading"><span class="form-heading-icon"><i class="bi bi-journal-check"></i></span><div><h2 class="h5 fw-bold mb-1">Información de la materia</h2><p class="small text-secondary mb-0">Usa hasta 8 letras o números, sin símbolos.</p></div></div><div class="card-body p-4 p-md-5 pt-3"><form method="post" class="entity-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><input type="hidden" asp-for="Materia.Id" /><div class="row g-3"><div class="col-12 col-md-5"><label asp-for="Materia.Codigo" class="form-label">Código</label><div class="input-group"><span class="input-group-text"><i class="bi bi-upc"></i></span><input asp-for="Materia.Codigo" class="form-control" maxlength="8" pattern="[A-Za-z0-9]{1,8}" oninput="this.value = this.value.replace(/[^a-zA-Z0-9]/g, '').slice(0, 8)" /></div><span asp-validation-for="Materia.Codigo" class="text-danger small"></span></div><div class="col-12 col-md-7"><label asp-for="Materia.Nombre" class="form-label">Nombre de la materia</label><div class="input-group"><span class="input-group-text"><i class="bi bi-book"></i></span><input asp-for="Materia.Nombre" class="form-control" /></div><span asp-validation-for="Materia.Nombre" class="text-danger small"></span></div></div><div class="form-actions mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Guardar cambios</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
