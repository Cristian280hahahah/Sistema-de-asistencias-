@page
@model SistemaAsistencia.Pages.Materias.DeleteModel
@{ ViewData["Title"] = "Eliminar materia"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">PLAN DE ESTUDIOS</span><h1 class="h2 fw-bold mb-1">Eliminar materia</h1><p class="text-secondary mb-0">Confirma la eliminación de esta asignatura.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5"><div class="alert alert-danger border-0" role="alert"><div class="d-flex gap-3"><i class="bi bi-exclamation-triangle-fill fs-4"></i><div><h2 class="h5 fw-bold">¿Eliminar esta materia?</h2><p class="mb-0">Esta acción no se puede deshacer.</p></div></div></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Código</dt><dd class="col-sm-8">@Model.Materia.Codigo</dd><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Materia.Nombre</dd></dl><form method="post" class="form-actions"><input type="hidden" asp-for="Materia.Id" /><button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Eliminar materia</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-x-lg me-2"></i>Cancelar</a></form></div></div></div></div>
