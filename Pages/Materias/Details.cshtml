@page
@model SistemaAsistencia.Pages.Materias.DetailsModel
@{ ViewData["Title"] = "Detalle de materia"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">PLAN DE ESTUDIOS</span><h1 class="h2 fw-bold mb-1">Detalle de materia</h1><p class="text-secondary mb-0">Información del catálogo académico.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4 detail-card"><div class="card-body p-4 p-md-5"><div class="d-flex align-items-center gap-3 mb-4"><span class="form-heading-icon"><i class="bi bi-journal-bookmark"></i></span><div><div class="small text-secondary">MATERIA</div><h2 class="h4 fw-bold mb-0">@Model.Materia.Nombre</h2></div></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Código</dt><dd class="col-sm-8"><span class="code-chip">@Model.Materia.Codigo</span></dd><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Materia.Nombre</dd></dl><div class="form-actions"><a asp-page="./Edit" asp-route-id="@Model.Materia.Id" class="btn btn-primary"><i class="bi bi-pencil-square me-2"></i>Editar materia</a><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></div></div></div></div>
