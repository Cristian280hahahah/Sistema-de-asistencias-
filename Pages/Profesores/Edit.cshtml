@page
@model SistemaAsistencia.Pages.Profesores.EditModel
@{ ViewData["Title"] = "Editar profesor"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">COMUNIDAD EDUCATIVA</span><h1 class="h2 fw-bold mb-1">Editar profesor</h1><p class="text-secondary mb-0">Actualiza los datos del integrante del equipo docente.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9 col-xl-8"><div class="card form-card form-professor border-0 shadow-sm rounded-4"><div class="form-card-heading"><span class="form-heading-icon"><i class="bi bi-person-gear"></i></span><div><h2 class="h5 fw-bold mb-1">Datos del profesor</h2><p class="small text-secondary mb-0">Comprueba la información antes de guardar.</p></div></div><div class="card-body p-4 p-md-5 pt-3">
<form method="post" class="entity-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><input type="hidden" asp-for="Profesores.Id" /><div class="row g-3"><div class="col-12"><label asp-for="Profesores.Nombre" class="form-label">Nombre completo</label><div class="input-group"><span class="input-group-text"><i class="bi bi-person"></i></span><input asp-for="Profesores.Nombre" class="form-control" /></div><span asp-validation-for="Profesores.Nombre" class="text-danger small"></span></div><div class="col-12"><label asp-for="Profesores.Email" class="form-label">Correo electrónico</label><div class="input-group"><span class="input-group-text"><i class="bi bi-envelope"></i></span>@if (Model.TieneCuentaVinculada) { <input asp-for="Profesores.Email" type="email" class="form-control" readonly /> } else { <input asp-for="Profesores.Email" type="email" class="form-control" autocapitalize="none" spellcheck="false" /> }</div>@if (Model.TieneCuentaVinculada) { <div class="form-text">El correo se usa para iniciar sesión y no se puede modificar mientras la cuenta esté vinculada.</div> }<span asp-validation-for="Profesores.Email" class="text-danger small"></span></div></div><div class="form-actions mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Guardar cambios</button><a asp-page="./Index" class="btn btn-light"><i class="bi bi-arrow-left me-2"></i>Volver al listado</a></div></form>
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
