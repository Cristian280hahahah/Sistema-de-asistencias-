@page
@model SistemaAsistencia.Pages.Profesores.DeleteModel
@{ ViewData["Title"] = "Eliminar profesor"; }
<div class="form-page-header mb-4"><span class="section-eyebrow">COMUNIDAD EDUCATIVA</span><h1 class="h2 fw-bold mb-1">Eliminar profesor</h1><p class="text-secondary mb-0">Confirma la eliminación del perfil docente.</p></div>
<div class="row justify-content-center"><div class="col-12 col-lg-9"><div class="card border-0 shadow-sm rounded-4"><div class="card-body p-4 p-md-5"><div class="alert @(Model.TieneCuentaVinculada ? "alert-warning" : "alert-danger") border-0" role="alert"><div class="d-flex gap-3"><i class="bi bi-exclamation-triangle-fill fs-4"></i><div><h2 class="h5 fw-bold">@(Model.TieneCuentaVinculada ? "Este profesor tiene una cuenta de acceso" : "¿Eliminar este profesor?")</h2><p class="mb-0">@(Model.TieneCuentaVinculada ? "Primero revoca la cuenta en Administración para conservar el control de acceso." : "Esta acción no se puede deshacer.")</p></div></div></div><div asp-validation-summary="ModelOnly" class="alert alert-danger border-0" role="alert"></div><dl class="row detail-list mb-4"><dt class="col-sm-4">Nombre completo</dt><dd class="col-sm-8">@Model.Profesores.Nombre</dd><dt class="col-sm-4">Correo electrónico</dt><dd class="col-sm-8">@Model.Profesores.Email</dd></dl><form method="post" class="form-actions"><input type="hidden" asp-for="Profesores.Id" />@if (!Model.TieneCuentaVinculada) { <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Eliminar profesor</button> }<a asp-page="./Index" class="btn btn-light"><i class="bi bi-x-lg me-2"></i>Cancelar</a></form></div></div></div></div>
